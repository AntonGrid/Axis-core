{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axisprotocol.org/schemas/attestation.schema.json",
  "title": "Attestation",
  "description": "Final attestation document produced by the oracle and consumed by on-chain bridge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "device_id",
    "proof",
    "decision",
    "oracle_id",
    "issued_at",
    "oracle_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the attestation schema."
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the attestation (UUID or domain-specific ID)."
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique device identifier."
    },
    "proof": {
      "type": "object",
      "description": "Incoming device proof object that oracle used to make decision.",
      "additionalProperties": false,
      "required": [
        "device_id",
        "nonce",
        "timestamp",
        "algo",
        "payload",
        "signature"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 UTC timestamp (e.g. 2026-07-25T19:00:00Z)."
        },
        "algo": {
          "type": "string",
          "minLength": 1,
          "description": "Proof algorithm identifier, e.g. 'mock', 'ed25519', etc."
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_power_kw"
          ],
          "properties": {
            "max_power_kw": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum allowed power for the device in kilowatts."
            }
          }
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Base64-encoded Ed25519 signature over the canonical proof message."
        }
      }
    },
    "decision": {
      "type": "object",
      "description": "Oracle decision derived from proof.",
      "additionalProperties": false,
      "required": [
        "allowed",
        "reason",
        "max_power_kw"
      ],
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "Whether device is allowed to operate."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable reason of decision."
        },
        "max_power_kw": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum allowed power in kilowatts decided by oracle."
        }
      }
    },
    "oracle_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of oracle instance which produced this attestation."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 UTC timestamp when attestation was issued (e.g. 2026-07-25T19:05:00Z)."
    },
    "oracle_signature": {
      "type": "string",
      "minLength": 1,
      "description": "Base64-encoded Ed25519 oracle signature over the canonical attestation message."
    }
  }
}
