{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axisprotocol.org/schemas/oracle_attest_request.schema.json",
  "title": "Oracle Attest Request",
  "description": "Request payload sent by devices (or demos) to the oracle /oracle/attest endpoint.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique device identifier."
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "description": "Random or sequential value to prevent replay attacks."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 UTC timestamp when the proof was created (e.g. 2026-07-25T19:00:00Z)."
    },
    "algo": {
      "type": "string",
      "minLength": 1,
      "description": "Proof algorithm identifier, e.g. 'mock', 'ed25519', etc."
    },
    "payload": {
      "type": "object",
      "description": "Algorithm-specific payload. For now we require max_power_kw.",
      "properties": {
        "max_power_kw": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum requested power in kilowatts."
        }
      },
      "required": ["max_power_kw"],
      "additionalProperties": true
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "description": "Hex-encoded signature of the proof payload."
    }
  },
  "required": [
    "device_id",
    "nonce",
    "timestamp",
    "algo",
    "payload",
    "signature"
  ]
}
