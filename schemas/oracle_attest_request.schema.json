{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oracle Attest Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "algo": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "max_power_kw": {
          "type": "number"
        }
      },
      "required": ["max_power_kw"],
      "additionalProperties": true
    },
    "signature": {
      "type": "string"
    }
  },
  "required": ["device_id", "nonce", "timestamp", "algo", "payload", "signature"]
}
