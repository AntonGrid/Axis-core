{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enrg.local/schemas/device-manifest.schema.json",
  "title": "DeviceManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_id": {
      "type": "string",
      "description": "Identifier of the manifest, typically base58",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the manifest (device definition), not firmware",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "manufacturer": {
      "type": "string",
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "maxLength": 256
    },
    "hw_revision": {
      "type": "string",
      "maxLength": 128
    },
    "fw_version": {
      "type": "string",
      "description": "Baseline firmware version associated with this manifest",
      "maxLength": 64
    },
    "public_key": {
      "type": "string",
      "description": "Device public key, base58 or base64-encoded",
      "minLength": 32,
      "maxLength": 256
    },
    "key_type": {
      "type": "string",
      "enum": [
        "ed25519"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Free-form manufacturer metadata",
      "additionalProperties": true
    }
  },
  "required": [
    "manifest_id",
    "version",
    "manufacturer",
    "model",
    "public_key",
    "key_type",
    "created_at"
  ]
}
