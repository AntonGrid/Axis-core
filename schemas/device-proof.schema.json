{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enrg.local/schemas/device-proof.schema.json",
  "title": "DeviceProof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "description": "Type of proof / attestation",
      "enum": [
        "provisioning",
        "bootstrap",
        "attestation"
      ]
    },
    "device_id": {
      "type": "string",
      "description": "Device identifier (base58)",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$"
    },
    "manifest_ref": {
      "type": "string",
      "description": "Reference to DeviceManifest.manifest_id",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$"
    },
    "nonce": {
      "type": "string",
      "description": "Random or pseudo-random nonce to protect from replay",
      "pattern": "^[0-9a-fA-F]{16,64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "description": "Attested payload, semantics depend on type",
      "additionalProperties": true,
      "properties": {
        "firmware_version": {
          "type": "string",
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "description": "High-level state of device",
          "maxLength": 64
        },
        "metrics": {
          "type": "object",
          "description": "Telemetry / metrics",
          "additionalProperties": true
        },
        "context": {
          "type": "object",
          "description": "Context of the proof (session ids, policy version, etc.)",
          "additionalProperties": true
        }
      }
    },
    "signature": {
      "type": "string",
      "description": "Digital signature of the canonicalized payload + context, base64-encoded",
      "pattern": "^[A-Za-z0-9+/=]{32,128}$"
    },
    "signature_algorithm": {
      "type": "string",
      "enum": [
        "ed25519"
      ]
    }
  },
  "required": [
    "type",
    "device_id",
    "manifest_ref",
    "nonce",
    "timestamp",
    "payload",
    "signature",
    "signature_algorithm"
  ]
}
